{
  "name": "dsh-resume-xray",
  "version": "0.3.0",
  "type": "module",
  "description": "Resume X-Ray: find resume claims that collapse under follow-up questions, then drill them one at a time.",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "resume",
    "interview"
  ],
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.md",
    "README.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  }
}
